profile home-desk {
  exec "niri msg output 'eDP-1' off"
  output "BOE 0x09DE Unknown" mode 1920x1080 position 3630,0 scale 1
  output "Samsung Electric Company S27E390 0x30343939" mode 1920x1080 position 1920,0 scale 1.0
  output "Lenovo Group Limited LEN P27q-10 0x01010101" mode 2560x1440  position 0,0 scale 1
}


profile work-desk {
  exec "niri msg output 'eDP-1' off"
  output "Samsung Electric Company LS27A600N HNMX400145" mode 2560x1440 position 0,0 scale 1.0
  output "BOE 0x09DE Unknown" mode 1920x1080 position 298,1440 scale 1
}


profile standalone {
  exec "niri msg output 'eDP-1' on"
  output "BOE 0x09DE Unknown" mode 1920x1080 position 0,0 scale 1
}
